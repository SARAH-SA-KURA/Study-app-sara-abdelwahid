# react-helmet-async@2.0.5 declares a peer range of react ^16 || ^17 || ^18,
# but this project runs react 19. Without this, `npm ci` fails with ERESOLVE
# on a clean install (Netlify, CI, or any fresh clone) before the build runs.
# The package itself works on react 19; the range is just stale/unmaintained.
legacy-peer-deps=true
